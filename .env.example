# ==========================================
# AI Career Intelligence System - Environment Config
# ==========================================

# Required for Gemini AI RAG & Explanation generation
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Web App URL injected by Cloud Run / Deployment
APP_URL="http://localhost:3000"

# Application Environment
# Set this to production on the deployment host.
NODE_ENV="development"
PORT=3000

# Authentication Secrets
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_career_db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="ai_career_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432

# Python ML Microservice URL
# Set this to the publicly reachable Python service URL if that service is deployed.
PYTHON_ML_SERVICE_URL="http://localhost:8000"

# Optional writable location for temporary resume uploads. This must be supplied
# by the host if the application filesystem is read-only.
UPLOAD_DIR="./uploads"

# Vector Store / RAG Configuration
VECTOR_STORE_PATH="./ml/vector_store"
FAISS_INDEX_NAME="job_embeddings_faiss"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
